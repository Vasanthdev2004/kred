# Copy to .env for local dev (Prisma's CLI reads .env, not .env.local).
# All values here are safe placeholders.

# WalletConnect / Reown project id. Free at https://cloud.reown.com (AppKit).
# Public by design — it is inlined into the client bundle, so it is not a secret.
#
# Left BLANK on purpose. A placeholder here is worse than nothing: RainbowKit still
# offers WalletConnect wallets, the relay rejects the bogus id, and the button does
# nothing at all. That is every mobile wallet dead with no error message, which is
# exactly how it reached production unnoticed. Injected wallets (MetaMask on
# desktop) work either way, which is what hides the problem.
NEXT_PUBLIC_WC_PROJECT_ID=

# Public app URL (used to build shareable request / verify links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Prisma metadata store (tags + disclosures only — never amounts).
# Postgres everywhere (Railway managed PG in deploy; use your own locally).
DATABASE_URL="postgresql://user:password@host:5432/railway"

# KredRegistry (F6) — on-chain disclosure anchor. Optional: the anchor UI + the
# "Anchored on-chain" badge stay dormant until this is set to a deployed address.
# Deploy with `npm run deploy:registry`, then paste the printed address here.
NEXT_PUBLIC_KRED_REGISTRY_ADDRESS=
# KredEscrow — milestone invoice escrow. Dormant until set.
NEXT_PUBLIC_KRED_ESCROW_ADDRESS=

# Deployer key for `npm run deploy:registry` ONLY (a funded Arc testnet wallet).
# Never commit a real key; leave blank unless you're deploying the contract.
DEPLOYER_PRIVATE_KEY=

# Kred assistant — Ollama Cloud. Server-only, never NEXT_PUBLIC_.
# One key, comma-separated keys, or OLLAMA_API_KEY_1..N to rotate across plans.
OLLAMA_API_KEY=
# Optional model override (default: gemma4:31b-cloud). Must support tool calling.
OLLAMA_MODEL=
